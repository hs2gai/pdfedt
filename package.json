{
  "name": "pdfedt",
  "private": true,
  "version": "0.4.4",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:ext": "tsc -b && vite build --mode extension",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "build:e2e": "cross-env VITE_E2E=1 vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "cf:deploy": "pnpm build && wrangler deploy",
    "cf:preview": "pnpm build && wrangler versions upload",
    "release": "python scripts/release.py",
    "release:dry": "python scripts/release.py --dry-run",
    "release:public": "python scripts/publish.py",
    "release:public:dry": "python scripts/publish.py --dry-run"
  },
  "dependencies": {
    "@embedpdf/core": "^2.15.1",
    "@embedpdf/engines": "^2.15.1",
    "@embedpdf/models": "^2.15.1",
    "@embedpdf/pdfium": "^2.15.1",
    "@embedpdf/plugin-annotation": "^2.15.1",
    "@embedpdf/plugin-document-manager": "^2.15.1",
    "@embedpdf/plugin-form": "2.15.1",
    "@embedpdf/plugin-history": "^2.15.1",
    "@embedpdf/plugin-interaction-manager": "^2.15.1",
    "@embedpdf/plugin-render": "^2.15.1",
    "@embedpdf/plugin-scroll": "^2.15.1",
    "@embedpdf/plugin-selection": "^2.15.1",
    "@embedpdf/plugin-thumbnail": "^2.15.1",
    "@embedpdf/plugin-viewport": "^2.15.1",
    "@embedpdf/plugin-zoom": "^2.15.1",
    "harfbuzzjs": "^1.6.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/chrome": "^0.3.0",
    "@types/emscripten": "^1.41.6",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "cross-env": "^10.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.135.0"
  }
}
