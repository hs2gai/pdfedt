+// pdfugu: whether a markup segment lies on a vertical column. A segment taller than wide does; so does a short one
+// (one glyph, or tate-chu-yoko "12" set side by side) sharing its exact left and right edges with another segment,
+// as pdfugu aligns the glyph boxes of a column to one extent (src/pdf/text-geometry.ts)
+function pdfuguIsVertical(r, rects) {
+  // Marked by pdfugu's patch of plugin-selection while selecting; the shape is all that is left on a saved annotation
+  if (r.vertical || r.size.height > r.size.width) return true;
+  return r.size.width <= 2 * r.size.height && rects.some((o) => o !== r && Math.abs(o.origin.x - r.origin.x) < 0.5 && Math.abs(o.size.width - r.size.width) < 0.5);
+}
