             position: "absolute",
-            left: 0,
-            bottom: 0,
-            width: "100%",
-            height: thickness,
+            // pdfugu: on a vertical column, underline it down its right side, thinner
+            // (0.75pt, as written by pdfugu's src/pdf/markup-vertical.ts)
+            ...(pdfuguIsVertical(r, segmentRects) ? { top: 0, right: 0, height: "100%", width: 0.75 * scale } : { left: 0, bottom: 0, width: "100%", height: thickness }),
             background: resolvedColor,
